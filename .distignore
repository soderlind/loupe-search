# Files and directories excluded from the wp.org SVN payload.
# Used by the 10up action-wordpress-plugin-deploy GitHub Action.

# Development and test files
.distignore
.github/
.gitignore
.gitattributes
.DS_Store
.editorconfig
.wp-env.json
.phpunit.cache/
phpunit.xml.dist
tests/

# Build / tooling config
node_modules/
package.json
package-lock.json
# composer.json should be included when vendor dependencies are committed, but excluded when they are not.
composer.lock

# Documentation (GitHub-only)
CHANGELOG.md
TODO.md
README.md
CONTEXT.md
docs/

# Dev-only vendor packages (phpunit, pest, brain/monkey, etc.)
# The deploy action runs `composer install --no-dev`, so vendor/ will be clean.
# List here just in case vendor/ is already committed with dev deps.
vendor/bin/
vendor/phpunit/
vendor/pestphp/
vendor/brain/
vendor/brianium/
vendor/phpstan/
vendor/fidry/
vendor/sebastian/
vendor/nikic/
vendor/phar-io/
vendor/phpdocumentor/
vendor/nunomaduro/
vendor/staabm/
vendor/ta-tikoma/

# Unused nitotm language-detector n-gram databases.
# Loupe loads only resources/ngrams/large.php (EldDataFile::LARGE, MODE_ARRAY).
# - extralarge.php: never loadable (MODE_ARRAY needs memory_limit >= 2000 MB).
# - medium.php / small.php: not loaded by Loupe (it hardcodes LARGE).
# - blob/: only used by string/bytes/disk modes, which Loupe does not use.
vendor/nitotm/efficient-language-detector/resources/ngrams/extralarge.php
vendor/nitotm/efficient-language-detector/resources/ngrams/medium.php
vendor/nitotm/efficient-language-detector/resources/ngrams/small.php
vendor/nitotm/efficient-language-detector/resources/ngrams/blob/

# Third-party CLI entry points. Not permitted in a wp.org payload: these are
# extension-less executables, and Loupe calls the libraries directly in PHP.
vendor/nitotm/efficient-language-detector/bin/
vendor/symfony/console/Resources/bin/
vendor/symfony/console/Resources/completion.bash
vendor/symfony/console/Resources/completion.fish
vendor/symfony/console/Resources/completion.zsh

# Composer download leftovers.
vendor/composer/tmp-*.zip~

# Third-party build / CI / lint config with no runtime role.
*.neon
*.dist
*.yml
*.yaml
*.exe
*.rst
*.rst.inc
Makefile
conf.py
.travis.yml
.scrutinizer.yml
.mailmap
.gitkeep

# php-stemmer test fixtures (language corpora, not loaded at runtime).
vendor/wamania/php-stemmer/test/

# wp.org assets live in .wordpress-org/ (mapped to SVN assets/ by the action)
.wordpress-org/

# GitHub-only update checker library. Updates on wp.org are served by WordPress.org,
# so this library must never ship in the wp.org payload.
vendor/yahnis-elsts/

# Test suites and fixtures bundled inside third-party runtime packages.
vendor/doctrine/deprecations/src/PHPUnit/
vendor/**/tests/
vendor/**/Tests/
vendor/**/test/
vendor/**/Test/

# Compound-word source dictionaries (loupe/matcher). Only used to rebuild the
# FastSet index (index_*.bin / hashes_*.bin) when it is missing. The prebuilt
# .bin indexes ship, so dictionary.gz is never read at runtime.
vendor/loupe/matcher/dictionaries/*/dictionary.gz

# Third-party package docs shipped alongside runtime code.
vendor/mjaschen/phpgeo/docs/
